<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.classgraph</groupId>
		<artifactId>classgraph-parent</artifactId>
		<version>5.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>classgraph-base</artifactId>
	<name>ClassGraph base</name>

	<description>The helper classes shared by the ClassGraph libraries: path and URL handling, logging, reflection, and accept/reject matching. This library has no public API of its own, and is not useful on its own.</description>

	<properties>
		<!-- The shared files (the code formatter profile and the license) are one directory up -->
		<rootDir>${project.basedir}/..</rootDir>

		<!-- The internal packages are exported to the modules that sit on top of this one, and those cannot be on
		     the module path while this module is compiled. javac cannot check the target of such an export, and
		     warns that the module was not found, which -Werror would turn into a build failure. -->
		<javacLintSuppressions>-Xlint:-exports,-module</javacLintSuppressions>

		<!-- Must agree with src/main/java/module-info.java -->
		<jpmsModuleName>io.github.classgraph.base</jpmsModuleName>
		<osgiBundleName>ClassGraph base</osgiBundleName>
		<!-- The internal packages are exported because OSGi has no equivalent of a qualified export, and the
		     modules above this one need them. They are marked x-internal so that tooling does not offer them
		     for import, and they are not covered by the project's API compatibility guarantees. -->
		<osgiExportPackage>io.github.classgraph.base;version="${project.version}",io.github.classgraph.base.internal.utils;x-internal:=true,io.github.classgraph.base.internal.reflection;x-internal:=true,io.github.classgraph.base.internal.concurrency;x-internal:=true,io.github.classgraph.base.internal.recycler;x-internal:=true</osgiExportPackage>
		<osgiImportPackage>javax.xml,javax.xml.xpath,javax.xml.namespace,javax.xml.parsers,org.w3c.dom,io.github.toolfactory.narcissus;resolution:="optional",org.jspecify.annotations;resolution:="optional"</osgiImportPackage>
		<osgiDependencies>java.xml,java.logging</osgiDependencies>

		<!-- This module produces a jar, so it needs its resources and the modular copy of its Javadoc -->
		<maven.antrun.skip>false</maven.antrun.skip>
		<maven.resources.skip>false</maven.resources.skip>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<!-- Every package in this module is internal, so the parent's exclusion of internal packages
					     would leave nothing at all to document, and Javadoc fails with "No public or protected
					     classes found to document" (JDK 17; later JDKs write an empty set of pages instead).
					     The internal packages are documented here instead, so that the module has a Javadoc jar
					     to publish, and so that doclint checks the Javadoc of these classes. They are still
					     absent from the aggregated Javadoc that the documentation site serves, since that
					     inherits the parent's exclusion, and none of this is public API. -->
					<excludePackageNames combine.self="override" />
					<additionalOptions>
						<!-- Javadoc only documents the exported packages of a module, and this module's packages
						     are only exported to the other ClassGraph modules -->
						<additionalOption>--show-packages all</additionalOption>
					</additionalOptions>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- Versions are pinned in the parent's dependencyManagement section -->
	<dependencies>
		<!-- Optional runtime dependency: if Narcissus is on the classpath, it is used as the reflection driver -->
		<dependency>
			<groupId>io.github.toolfactory</groupId>
			<artifactId>narcissus</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
</project>
