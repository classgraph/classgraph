<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.classgraph</groupId>
		<artifactId>classgraph-parent</artifactId>
		<version>5.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>classgraph-vfs</artifactId>
	<name>ClassGraph virtual filesystem</name>

	<description>A virtual filesystem: reads directories, jarfiles and modules through one interface, however they are named.</description>

	<properties>
		<!-- The shared files (the code formatter profile and the license) are one directory up -->
		<rootDir>${project.basedir}/..</rootDir>

		<!-- The internal packages are exported to io.github.classgraph, which sits on top of this module and so
		     cannot be on the module path while this module is compiled. javac cannot check the target of such an
		     export, and warns that the module was not found, which -Werror would turn into a build failure. -->
		<javacLintSuppressions>-Xlint:-exports,-module</javacLintSuppressions>

		<!-- Must agree with src/main/java/module-info.java -->
		<jpmsModuleName>io.github.classgraph.vfs</jpmsModuleName>
		<osgiBundleName>ClassGraph virtual filesystem</osgiBundleName>
		<!-- The internal packages are exported because OSGi has no equivalent of a qualified export, and the
		     modules above this one need them. They are marked x-internal so that tooling does not offer them
		     for import, and they are not covered by the project's API compatibility guarantees. -->
		<osgiExportPackage>io.github.classgraph.vfs;version="${project.version}",io.github.classgraph.vfs.internal;x-internal:=true,io.github.classgraph.vfs.internal.slice;x-internal:=true,io.github.classgraph.vfs.internal.slice.reader;x-internal:=true,io.github.classgraph.vfs.internal.zip;x-internal:=true,io.github.classgraph.vfs.internal.module;x-internal:=true</osgiExportPackage>
		<osgiImportPackage>io.github.classgraph.base.internal.concurrency,io.github.classgraph.base.internal.recycler,io.github.classgraph.base.internal.utils,org.jspecify.annotations;resolution:="optional"</osgiImportPackage>
		<osgiDependencies>io.github.classgraph.base</osgiDependencies>

		<!-- This module produces a jar, so it needs its resources and the modular copy of its Javadoc -->
		<maven.antrun.skip>false</maven.antrun.skip>
		<maven.resources.skip>false</maven.resources.skip>
	</properties>

	<!-- Versions are pinned in the parent's dependencyManagement section -->
	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>classgraph-base</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Test dependencies: -->
		<!-- An in-memory filesystem, used to test that a Path in a filesystem other than the default one can be
		     opened -->
		<dependency>
			<groupId>com.google.jimfs</groupId>
			<artifactId>jimfs</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
