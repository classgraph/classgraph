<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.classgraph</groupId>
		<artifactId>classgraph-parent</artifactId>
		<version>5.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>classgraph-vfs</artifactId>
	<name>ClassGraph virtual filesystem</name>

	<description>A virtual filesystem: reads directories, jarfiles and modules through one interface, however they are named.</description>

	<properties>
		<!-- The shared files (the code formatter profile and the license) are one directory up -->
		<rootDir>${project.basedir}/..</rootDir>

		<!-- The internal packages are exported to io.github.classgraph, which sits on top of this module and so
		     cannot be on the module path while this module is compiled. javac cannot check the target of such an
		     export, and warns that the module was not found, which -Werror would turn into a build failure. -->
		<javacLintSuppressions>-Xlint:-exports,-module</javacLintSuppressions>

		<osgiBundleName>ClassGraph virtual filesystem</osgiBundleName>
		<!-- Must list the same packages as the exports in src/main/java/module-info.java. -->
		<osgiExportPackage>io.github.classgraph.vfs;version="${project.version}",io.github.classgraph.vfs.reader;version="${project.version}"</osgiExportPackage>
		<!-- sun.misc is imported optionally because OffHeapMemory looks up Unsafe by name on JDK 17-21, and an
		     OSGi bundle can only load a class from a package it imports. -->
		<osgiImportPackage>io.github.classgraph.base,io.github.classgraph.base.internal.concurrency,io.github.classgraph.base.internal.path,io.github.classgraph.base.internal.reflection,io.github.classgraph.base.internal.utils,sun.misc;resolution:="optional",org.jspecify.annotations;resolution:="optional"</osgiImportPackage>
		<osgiDependencies>io.github.classgraph.base export,jdk.unsupported</osgiDependencies>

		<!-- This module has sources and produces a jar, so it needs the ecj checks and the license copies -->
		<maven.antrun.skip>false</maven.antrun.skip>
		<maven.resources.skip>false</maven.resources.skip>
	</properties>

	<!-- Versions are pinned in the parent's dependencyManagement section -->
	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>classgraph-base</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Test dependencies: -->
		<!-- An in-memory filesystem, used to test that a Path in a filesystem other than the default one can be
		     opened -->
		<dependency>
			<groupId>com.google.jimfs</groupId>
			<artifactId>jimfs</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
