<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.classgraph</groupId>
		<artifactId>classgraph-parent</artifactId>
		<version>4.8.190-SNAPSHOT</version>
	</parent>

	<artifactId>classgraph</artifactId>
	<name>ClassGraph</name>

	<description>The uber-fast, ultra-lightweight classpath and module scanner for JVM languages.</description>

	<properties>
		<!-- The shared files (the code formatter profile and the license) are one directory up -->
		<rootDir>${project.basedir}/..</rootDir>

		<!-- Must agree with src/main/java/module-info.java -->
		<jpmsModuleName>io.github.classgraph</jpmsModuleName>
		<osgiBundleName>ClassGraph</osgiBundleName>
		<osgiExportPackage>io.github.classgraph;version="${project.version}"</osgiExportPackage>
		<osgiImportPackage>io.github.classgraph.classpath,io.github.classgraph.vfs,nonapi.io.github.classgraph.classloaderhandler,nonapi.io.github.classgraph.classpath,nonapi.io.github.classgraph.classpathspec,nonapi.io.github.classgraph.concurrency,nonapi.io.github.classgraph.fastzipfilereader,nonapi.io.github.classgraph.fileslice,nonapi.io.github.classgraph.fileslice.reader,nonapi.io.github.classgraph.recycler,nonapi.io.github.classgraph.reflection,nonapi.io.github.classgraph.utils,nonapi.io.github.classgraph.vfsspec,org.jspecify.annotations;resolution:="optional"</osgiImportPackage>
		<osgiDependencies>io.github.classgraph.classpath,io.github.classgraph.vfs</osgiDependencies>

		<!-- This module produces a jar, so it needs its resources and the modular copy of its Javadoc -->
		<maven.antrun.skip>false</maven.antrun.skip>
		<maven.resources.skip>false</maven.resources.skip>
	</properties>

	<!-- Versions are pinned in the parent's dependencyManagement section -->
	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>classgraph-vfs</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Test dependencies: -->
		<!-- Narcissus is an optional dependency of classgraph-classpath, so it is not inherited here. The tests
		     that check what can be reached only with Narcissus installed need it on the test classpath. -->
		<dependency>
			<groupId>io.github.toolfactory</groupId>
			<artifactId>narcissus</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.openjdk.jmh</groupId>
			<artifactId>jmh-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.openjdk.jmh</groupId>
			<artifactId>jmh-generator-annprocess</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>javax.enterprise</groupId>
			<artifactId>cdi-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.ops4j.pax.url</groupId>
			<artifactId>pax-url-aether</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-jdk14</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.hibernate.javax.persistence</groupId>
			<artifactId>hibernate-jpa-2.1-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.google.jimfs</groupId>
			<artifactId>jimfs</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
